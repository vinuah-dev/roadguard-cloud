# Settings for docker compose (copy to .env). On AWS, deploy/aws/user-data.sh writes .env for you.

# Password of the PostgreSQL container (letters and digits only, it goes into a URL)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Optional: protect "Mark Repaired" and "Reset Test Data" with an admin token
ROADGUARD_ADMIN_TOKEN=

# Optional: switch the /api/test/* diagnostics endpoints off
ROADGUARD_ENABLE_TEST_API=true
