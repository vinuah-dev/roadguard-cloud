# ========================================
# RoadGuard Server - Environment Configuration Template
# Copy this file to server/.env and change what you need.
# Every value is optional: with no .env the server runs on a local SQLite file.
# NEVER commit server/.env with real credentials to source control.
# ========================================

# --- Database ---
# Empty = SQLite at server/data/roadguard.db (local development).
# PostgreSQL (Docker, EC2 or Amazon RDS):
#   DATABASE_URL=postgresql://roadguard:<password>@localhost:5432/roadguard
DATABASE_URL=

# Insert the 5 Nagpur demo hazards when the database is empty.
ROADGUARD_SEED_DEMO_DATA=true

# --- Security ---
# When set, resolving/re-grading hazards (PATCH /api/hazards/{id}) and wiping test data
# need this value in the X-Admin-Token header. The dashboard asks for it once.
ROADGUARD_ADMIN_TOKEN=
# Turn the /api/test/* diagnostics endpoints off on a production deployment.
ROADGUARD_ENABLE_TEST_API=true
# Comma-separated list of allowed browser origins for the REST API.
ROADGUARD_CORS_ORIGINS=*

# --- Detection ---
# Store a hazard automatically when the live telemetry stream classifies a pothole / speed breaker.
ROADGUARD_AUTO_INGEST=true
# Train the Random Forest from ml/data at startup when ml/models has no usable model.
ROADGUARD_ML_AUTO_TRAIN=true

# --- App ---
ROADGUARD_APP_VERSION=4.0.0
ROADGUARD_LOG_LEVEL=INFO

# --- Deployment info shown in the dashboard (filled in automatically on AWS by user-data.sh) ---
ROADGUARD_PLATFORM=Local machine
ROADGUARD_REGION=
ROADGUARD_AZ=
ROADGUARD_INSTANCE_ID=
ROADGUARD_INSTANCE_TYPE=
ROADGUARD_PUBLIC_HOST=

# --- BLE Configuration (must match the ESP32 firmware) ---
BLE_SERVICE_UUID=6E400001-B5A3-F393-E0A9-E50E24DCCA9E
BLE_CHARACTERISTIC_UUID_TX=6E400003-B5A3-F393-E0A9-E50E24DCCA9E
BLE_CHARACTERISTIC_UUID_RX=6E400002-B5A3-F393-E0A9-E50E24DCCA9E
BLE_DEVICE_NAME_PREFIX=RoadGuard-ESP32
